    "@typescript-eslint/parser": "8.74.0",
    "@vitejs/plugin-react": "^4.6.0",
    "axe-core": "4.10.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.56.1",
    "stylelint": "16.25.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^4.1.1"
